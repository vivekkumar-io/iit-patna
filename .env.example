# Enterprise Knowledge Assistant - Environment Variables
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Required: OpenAI API key for embeddings and chat completions
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: override defaults from app/config.py
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CHUNK_SIZE=600
# CHUNK_OVERLAP=120
# RETRIEVAL_TOP_K=8
# RERANK_CANDIDATE_MAX=12
# RERANK_TOP_N=5
# MEMORY_WINDOW=5

# UI: set to false to skip the welcome landing page and open chat directly
# SHOW_WELCOME_PAGE=true
